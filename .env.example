# Copy to .env and adjust for your environment.

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=samplerack
DB_PORT=5432

# --- API ---
API_PORT=5280
# IMPORTANT: use a long, random secret (>= 32 bytes) in production.
JWT_KEY=change-this-to-a-long-random-secret-at-least-32-bytes-in-production
SWAGGER_ENABLED=true

# --- Seeded administrator (created on first run only) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@12345
ADMIN_EMAIL=admin@samplerack.local

# --- Web (nginx) ---
WEB_PORT=8080
